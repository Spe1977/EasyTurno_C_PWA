{
  "name": "easyturno",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "engines": {
    "node": "^20.19.0 || ^22.12.0 || >=24.0.0",
    "npm": ">=10.0.0"
  },
  "scripts": {
    "dev": "NG_CLI_ANALYTICS=false ng serve",
    "dev:pw": "NG_CLI_ANALYTICS=false ng serve --watch=false --host 127.0.0.1 --port 3100",
    "build": "ng build",
    "preview": "NG_CLI_ANALYTICS=false ng serve --configuration=production",
    "format": "prettier --write \"src/**/*.{ts,html,css,scss,json}\"",
    "format:check": "prettier --check \"src/**/*.{ts,html,css,scss,json}\"",
    "lint": "eslint \"src/**/*.ts\"",
    "lint:fix": "eslint \"src/**/*.ts\" --fix",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "prepare": "husky",
    "build:mobile": "npm run build && npx cap sync",
    "android:dev": "npm run build:mobile && npx cap open android",
    "android:build": "npm run build && npx cap sync && cd android && ./gradlew assembleRelease",
    "cap:sync": "npx cap sync",
    "cap:update": "npm run build && npx cap sync",
    "test:pw": "playwright test",
    "test:pw:ui": "playwright test --ui",
    "test:pw:headed": "playwright test --headed",
    "test:pw:debug": "playwright test --debug",
    "test:pw:install": "playwright install --with-deps chromium",
    "emulators": "firebase emulators:start --project demo-easyturno --only auth,firestore",
    "test:firebase": "firebase emulators:exec --project demo-easyturno --only auth,firestore \"npm test -- src/services/sync-emulator.spec.ts --runInBand\""
  },
  "dependencies": {
    "@angular/common": "^22.2.6",
    "@angular/compiler": "^22.2.6",
    "@angular/core": "^22.2.6",
    "@angular/forms": "^22.2.6",
    "@angular/platform-browser": "^22.2.6",
    "@capacitor/app": "^8.1.2",
    "@capacitor/core": "^8.6.2",
    "@capacitor/haptics": "^8.0.2",
    "@capacitor/local-notifications": "^8.3.1",
    "@capacitor/push-notifications": "^8.1.3",
    "@capacitor/share": "^8.0.3",
    "@capacitor/splash-screen": "^8.0.2",
    "@capacitor/status-bar": "^8.0.4",
    "firebase": "^13.4.0",
    "rxjs": "^7.8.2"
  },
  "devDependencies": {
    "@angular/build": "^22.2.7",
    "@angular/cli": "^22.2.7",
    "@angular/compiler-cli": "^22.2.6",
    "@capacitor/android": "^8.6.2",
    "@capacitor/cli": "^8.6.2",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.65.1",
    "@tailwindcss/postcss": "^4.3.5",
    "@types/jest": "^30.0.0",
    "@types/node": "^25.9.9",
    "@typescript-eslint/eslint-plugin": "^8.73.0",
    "@typescript-eslint/parser": "^8.73.0",
    "eslint": "^10.15.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.7",
    "firebase-tools": "^15.36.0",
    "husky": "^9.1.7",
    "jest": "^30.5.2",
    "jest-environment-jsdom": "^30.5.2",
    "jest-preset-angular": "^17.0.3",
    "lint-staged": "^17.6.1",
    "postcss": "^8.5.33",
    "prettier": "^3.10.1",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "tailwindcss": "^4.3.5",
    "ts-jest": "^29.4.15",
    "typescript": "~6.0.3",
    "zone.js": "~0.16.3"
  },
  "overrides": {
    "@grpc/grpc-js": "^1.14.7"
  },
  "lint-staged": {
    "*.ts": [
      "prettier --write",
      "eslint --fix --no-warn-ignored",
      "jest --bail --findRelatedTests --passWithNoTests"
    ],
    "*.html": [
      "prettier --write"
    ],
    "*.css": [
      "prettier --write"
    ]
  }
}
